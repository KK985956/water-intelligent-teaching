# Copy this file to backend/.env for local development.
# Never commit real API keys. backend/.env is ignored by git.

# Flask/server
WATER_SECRET_KEY=replace-with-a-random-secret
WATER_TOKEN_TTL_SECONDS=43200
WATER_DEMO_CAPTCHA=2026

# Database: use one of the following URLs when running with MySQL/PostgreSQL.
# WATER_DATABASE_URL=postgresql://water:water@127.0.0.1:5432/water_teaching
# WATER_DATABASE_URL=mysql+pymysql://water:water@127.0.0.1:3306/water_teaching?charset=utf8mb4

# Python generation service
WATER_GENERATION_SERVICE_PORT=5001
# WATER_GENERATION_SERVICE_URL=http://127.0.0.1:5001
WATER_GENERATION_SERVICE_TIMEOUT_SECONDS=30

# WebSocket progress channel
WATER_PROGRESS_SOCKET_HOST=127.0.0.1
WATER_PROGRESS_SOCKET_PORT=8765

OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
WATER_AI_COURSEWARE_ENABLED=1
WATER_OPENAI_TEXT_MODEL=gpt-4.1-mini
WATER_OPENAI_IMAGE_MODEL=gpt-image-1
WATER_OPENAI_IMAGE_ENABLED=0
